generator client {
  provider   = "prisma-client"
  output     = "../lib/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int        @id @default(autoincrement())
  username  String
  email     String     @unique
  avatarUrl String?
  bio       String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  contacts  Contact[]
  Sequences Sequence[]
  snippets  Snippet[]
  frames    Frame[]
  assets    Asset[]
  comments  Comment[]
}

model Sequence {
  id          Int        @id @default(autoincrement())
  title       String
  description String
  url         String?
  userId      Int
  FrameOrder  Int[]
  visibility  Visibility @default(PUBLIC)
  isDeleted   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id])
  snippets    Snippet[]
  comments    Comment[]

  @@index([title, userId])
}

model Frame {
  id          Int       @id @default(autoincrement())
  type        FrameType @default(PHRASE)
  description String?
  content     String
  createdById Int?
  createdBy   User?     @relation(fields: [createdById], references: [id])
  /// Set for IMAGE frames: the picture shown in the frame.
  assetId     Int?
  asset       Asset?    @relation(fields: [assetId], references: [id])
  /// Optional web link the frame opens in a new tab. Always an http(s) URL
  /// checked by `parseFrameLink` (lib/frame-link.ts) before it's stored.
  linkUrl     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  snippets    Snippet[]

  @@index([createdAt])
  @@index([createdById])
  @@index([assetId])
}

/// An uploaded file (Vercel Blob, or local disk in dev/e2e).
model Asset {
  id           Int      @id @default(autoincrement())
  url          String
  /// Storage key, `assets/<uploadedById>/<uuid>.<ext>`.
  pathname     String   @unique
  contentType  String
  size         Int
  width        Int
  height       Int
  uploadedById Int
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  frames       Frame[]
  createdAt    DateTime @default(now())

  @@index([uploadedById])
}

/// A comment on a sequence. Soft-deleted with `isDeleted`.
model Comment {
  id         Int      @id @default(autoincrement())
  content    String
  sequenceId Int
  authorId   Int
  isDeleted  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  sequence   Sequence @relation(fields: [sequenceId], references: [id])
  author     User     @relation(fields: [authorId], references: [id])

  @@index([sequenceId, createdAt])
  @@index([authorId])
}

model Contact {
  id        Int      @id @default(autoincrement())
  userId    Int
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Snippet {
  id               Int       @id @default(autoincrement())
  type             FrameType @default(PHRASE)
  notes            String?
  frameId          Int
  frame            Frame     @relation(fields: [frameId], references: [id])
  originSequenceId Int
  createdById      Int
  originSequence   Sequence  @relation(fields: [originSequenceId], references: [id])
  createdBy        User      @relation(fields: [createdById], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([createdById])
  @@index([originSequenceId])
}

enum FrameType {
  PHRASE
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

enum Visibility {
  PUBLIC
  PRIVATE
  FRIENDS_ONLY
}
