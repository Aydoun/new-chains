generator client {
  provider   = "prisma-client"
  output     = "../lib/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int        @id @default(autoincrement())
  username  String
  email     String     @unique
  avatarUrl String?
  bio       String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  contacts  Contact[]
  Sequences Sequence[]
  snippets  Snippet[]
  frames    Frame[]
}

model Sequence {
  id          Int        @id @default(autoincrement())
  title       String
  description String
  url         String?
  userId      Int
  FrameOrder  Int[]
  visibility  Visibility @default(PUBLIC)
  isDeleted   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id])
  snippets    Snippet[]

  @@index([title, userId])
}

model Frame {
  id          Int       @id @default(autoincrement())
  type        FrameType @default(PHRASE)
  description String?
  content     String
  createdById Int?
  createdBy   User?     @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  snippets    Snippet[]

  @@index([createdAt])
  @@index([createdById])
}

model Contact {
  id        Int      @id @default(autoincrement())
  userId    Int
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Snippet {
  id               Int       @id @default(autoincrement())
  type             FrameType @default(PHRASE)
  notes            String?
  frameId          Int
  frame            Frame     @relation(fields: [frameId], references: [id])
  originSequenceId Int
  createdById      Int
  originSequence   Sequence  @relation(fields: [originSequenceId], references: [id])
  createdBy        User      @relation(fields: [createdById], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([createdById])
  @@index([originSequenceId])
}

enum FrameType {
  PHRASE
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

enum Visibility {
  PUBLIC
  PRIVATE
  FRIENDS_ONLY
}
