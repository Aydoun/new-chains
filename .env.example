# Copy to .env (or .env.local) and fill in. Production values live in Vercel.

# Postgres (Neon). Use a separate database for local development.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# End-to-end tests (Playwright) read .env.test, not this file.
# Copy these keys to .env.test. DATABASE_URL there must be a dedicated Neon
# test branch: the tests create and delete data, and refuse to run against a
# database used by any other env file.
#
# DATABASE_URL=<Neon test branch, pooled connection string>
# NEXTAUTH_SECRET=<any random value, used to sign the test session cookie>
# DIRECT_DATABASE_URL=<optional; unpooled URL for migrations. Defaults to
#   DATABASE_URL with "-pooler" removed from the host, Neon's convention>
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET can be dummy values.
